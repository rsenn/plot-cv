# SSL configuration
#
# Note: You should disable gzip for SSL traffic.
# See: https://bugs.debian.org/773332
#
# Read up on ssl_ciphers to ensure a secure configuration.
# See: https://bugs.debian.org/765782
#
# Self signed certs generated by the ssl-cert package
# Don't use them in a production server!
#
# include snippets/snakeoil.conf;

server {
	listen 443 ssl default_server;
	listen [::]:443 ssl default_server;

	ssl_protocols TLSv1 TLSv1.1 TLSv1.2 TLSv1.3; # Dropping SSLv3, ref: POODLE
	ssl_prefer_server_ciphers on;

	# www.transistorisiert.ch needs its own certificate: nginx.crt only covers the
	# apex name (see tools/www-cert.sh)
	ssl_certificate     /etc/nginx/www.crt;
	ssl_certificate_key /etc/nginx/www.key;

  #root /home/roman/Projects/plot-cv/;
  root /var/www/transistorisiert.ch/;

	# Add index.php to the list if you are using PHP
  index index.html;

	server_name www.transistorisiert.ch transistorisiert.ch;

   # serve static files
  #location /ol-st/ { 
  #  root    /var/www/html/ol-st/;
  #  expires 30d;
  #}
  #
   # serve static files
  #location ^~ /thomson-calculator/ {
  #  root    /home/roman/Sources/thomson-calculator/src/; 
  #  expires 30d;
  #}

  # static assets live below the site root (tools/build-site.mjs)
  location ~ ^/(images|javascript|js|css|flash|media|static|lib|openlayers)/ {
    expires 1h;
  }


  location /debug {
    proxy_pass http://127.0.0.1:8998/;
    include proxy_params;
  }
  #location ~ .* {
  #  proxy_pass http://127.0.0.1:8999;
  #}
  #location @upload-server {
  #  proxy_pass http://127.0.0.1:8999;
  #}
  
  #location / {
  #  try_files $uri $uri/ @upload-server;
  #}

  location /ws {
    proxy_pass http://127.0.0.1:8999;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Host $host;
  }  
  location /uploads {
    proxy_pass http://127.0.0.1:8999;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Host $host;
  }  
  location /moreload {
    proxy_pass http://127.0.0.1:9000;
  }
  location = /tonnetz {
    return 301 $scheme://$host/tonnetz/;
  }
  location = /tonnetz/manifest.webmanifest {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-sound/tonnetz/manifest.webmanifest;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
  }
  location ^~ /tonnetz/ {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-sound/tonnetz/;
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location ^~ /qjs-modules/ {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-modules/;
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location ^~ /qjs-lws/ {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-lws/;
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location ^~ /qjs-opencv/ {
    alias /mnt/data/Projects/plot-cv/qjs-opencv/;
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location ^~ /qjs-glfw/ {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-glfw/;
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location ^~ /qjs-nanovg/ {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-nanovg/;
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location = /nanovg {
    return 301 $scheme://$host/nanovg/;
  }
  location ^~ /nanovg/ {
    include mime.types;
    types {
      application/wasm wasm;
      application/javascript mjs;
    }
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location /projects {
    proxy_pass http://127.0.0.1:8085/;
    include proxy_params;
  }
  location = /eagle {
    return 301 $scheme://$host/eagle/;
  }
  location /eagle/ {
    proxy_pass http://127.0.0.1:3000/;
    include proxy_params;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    client_max_body_size 512m;
  }
  location /wild-beauty/ {
    proxy_pass http://127.0.0.1:3001/;
    include proxy_params;
  }
  location /gallery/ {
    proxy_pass http://127.0.0.1:9966/;
    include proxy_params;
  }
  location /webakeit/ {
    proxy_pass http://127.0.0.1:80/;
    include proxy_params;
  }
  location /Elfenkranz/ {
      autoindex on;
  }
}

