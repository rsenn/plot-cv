# Default server configuration
#
server {
	listen 80 default_server;
	listen [::]:80 default_server;

	# SSL configuration
	#
	# listen 443 ssl default_server;
	# listen [::]:443 ssl default_server;
	#
	# Note: You should disable gzip for SSL traffic.
	# See: https://bugs.debian.org/773332
	#
	# Read up on ssl_ciphers to ensure a secure configuration.
	# See: https://bugs.debian.org/765782
	#
	# Self signed certs generated by the ssl-cert package
	# Don't use them in a production server!
	#
	# include snippets/snakeoil.conf;

  #root /home/roman/Projects/plot-cv/;
  root /var/www/transistorisiert.ch/;

	# Add index.php to the list if you are using PHP
	index index.html;

	server_name www.transistorisiert.ch transistorisiert.ch;

  # acme.sh renews with webroot /var/www/html, which is no longer the site root
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/html;
  }

   # serve static files
  # static assets live below the site root (tools/build-site.mjs)
  location ~ ^/(images|javascript|js|css|flash|media|static|lib|openlayers)/ {
    expires 1h;
  }
  #location ~ .* {
  #  proxy_pass http://127.0.0.1:8999;
  #}
  location @upload-server {
    proxy_pass http://127.0.0.1:8999;
  }
  location / {
    try_files $uri $uri/ @upload-server;
  }
  location /ws {
    proxy_pass http://127.0.0.1:8999;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }  
  location /uploads {
    proxy_pass http://127.0.0.1:8999;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }  
  location /warmcat {
    proxy_pass http://warmcat.com;
    #proxy_http_version 1.1;
    #proxy_set_header Upgrade $http_upgrade;
    #proxy_set_header Connection "Upgrade";
    #proxy_set_header Host $host;
    #proxy_read_timeout 86400s;
    #proxy_send_timeout 86400s;
  }  
  location /moreload {
    proxy_pass http://127.0.0.1:9000;
  }
  location /webakeit/ {
    proxy_pass http://127.0.0.1:80/;
    include proxy_params;
  }
  location /wild-beauty/ {
    proxy_pass http://127.0.0.1:3001/;
    include proxy_params;
  }
  location = /tonnetz {
    return 301 $scheme://$host/tonnetz/;
  }
  location = /tonnetz/manifest.webmanifest {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-sound/tonnetz/manifest.webmanifest;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
  }
  location ^~ /tonnetz/ {
    alias /mnt/data/Projects/plot-cv/quickjs/qjs-sound/tonnetz/;
    index index.html;
    add_header Cache-Control "no-cache";
  }
  location /projects {
    proxy_pass http://127.0.0.1:8085/;
    include proxy_params;
  }
  location ~ ^/eagle {
    return 301 https://$host/eagle;
  }
  #location ~ ^/$ {
  #  return 301 $scheme://$host/directory.html;
  #}
}


